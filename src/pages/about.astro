---
import Header from '../components/Header';
import Main from '../components/Main';
import { pages } from '../utils/constants';
import BaseLayout from '../layouts/BaseLayout.astro';
import type { PageSection, PageSectionDetail } from '../utils/types';

const { title, subtitle, sections } = pages.about;
const pageTitle = 'Ryan Chase / Portfolio - About';
const section = sections?.[0];
const { image, details } = section || {};
const paragraphs =
  section?.description?.split('\n').filter((p) => p.trim()) || [];
---

<BaseLayout title={pageTitle}>
  <Header title={title} subtitle={subtitle} client:load />
  <Main client:load>
    <section
      class="grid grid-cols-1 lg:grid-cols-[66.666%_33.333%] grid-rows-[auto_auto] mb-4 lg:mb-0 transition-all duration-out ease-out [&_h3]:mt-6 sm:[&_h3]:mt-7 md:[&_h3]:mt-8 lg:mt-0 [&_h3]:transition-all [&_h3]:duration-out [&_h3]:ease-out"
    >
      <div class="mr-0 lg:mr-16 transition-all duration-out ease-out">
        {section?.title && <h3>{section.title}</h3>}
        {paragraphs.map((paragraph) => <p>{paragraph}</p>)}
      </div>
      <aside
        class="flex flex-col sm:flex-row lg:flex-col items-center sm:items-start mt-16 sm:mt-20 md:mt-24 lg:mt-0 transition-all duration-out ease-out"
      >
        {
          image && (
            <div class="flex-grow-0 w-2/3 sm:w-1/3 lg:w-full m-0 sm:ml-8 lg:m-0 overflow-hidden transition-all duration-out ease-out [&>img]:rounded-full">
              <img
                src={image.path}
                alt={image.alt}
                class="w-full h-auto rounded-full"
              />
            </div>
          )
        }
        {
          details && details.length > 0 && (
            <ul class="flex-grow w-full sm:w-2/3 lg:w-full m-0 sm:ml-12 md:ml-16 lg:ml-0 lg:mt-16 p-0 list-none uppercase transition-all duration-out ease-out [&>li]:flex [&>li]:items-center [&>li]:h-16 [&>li]:px-4 sm:[&>li]:px-0 [&>li]:tracking-[0.25rem] sm:[&>li]:tracking-[0.125rem] md:[&>li]:tracking-[0.125rem] lg:[&>li]:tracking-[0.25rem] [&>li]:text-base [&>li]:transition-all [&>li]:duration-out [&>li]:ease-out [&>li.no-border]:border-t-0 [&>li+li]:border-t-2 [&>li+li]:border-mischka [&>li>label]:mr-4 [&>li>strong]:flex-grow [&>li>strong]:font-medium [&>li>strong]:text-right">
              {details.map((detail, i) => (
                <li class={!detail.label ? 'no-border' : ''}>
                  {detail.label && (
                    <label for={`detail-${i}`}>{detail.label}</label>
                  )}
                  <strong id={`detail-${i}`}>{detail.value}</strong>
                </li>
              ))}
            </ul>
          )
        }
      </aside>
    </section>
  </Main>
</BaseLayout>
